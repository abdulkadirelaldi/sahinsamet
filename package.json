{
  "name": "sahinsamet",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22.11.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "onizle": "next build && PORT=3000 node tests/olcum-sunucusu.mjs",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "db:up": "docker compose -f docker-compose.dev.yml up -d",
    "db:down": "docker compose -f docker-compose.dev.yml down",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate",
    "db:seed": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./prisma/seed-register.mjs prisma/seed.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.3.0",
    "@hookform/resolvers": "5.7.1",
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "@simplewebauthn/browser": "14.0.0",
    "@simplewebauthn/server": "14.0.3",
    "argon2": "0.45.1",
    "clsx": "2.1.1",
    "lucide-react": "1.28.0",
    "next": "15.5.28",
    "next-auth": "5.0.0-beta.32",
    "otplib": "13.4.1",
    "pg": "8.22.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "7.84.0",
    "tailwind-merge": "3.6.0",
    "web-push": "3.6.7",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "15.5.22",
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.3",
    "@types/node": "20.19.43",
    "@types/pg": "8.20.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@types/web-push": "3.6.4",
    "@typescript-eslint/eslint-plugin": "8.66.0",
    "@typescript-eslint/parser": "8.66.0",
    "@vitejs/plugin-react": "6.0.5",
    "@vitest/coverage-v8": "4.1.12",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.22",
    "jsdom": "26.1.0",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "0.8.1",
    "prisma": "7.9.1",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.2.4",
    "vite-tsconfig-paths": "6.1.1",
    "vitest": "4.1.12"
  },
  "pnpm": {
    "overrides": {
      "postcss": ">=8.5.28 <9.0.0",
      "mysql2": ">=3.23.1 <4.0.0",
      "deepmerge-ts": ">=8.0.0 <9.0.0",
      "fast-uri": "^3.1.9"
    }
  }
}
