# =============================================================================
# .env.example — ortam değişkenleri
#
# §8.17: Bu dosya TÜM anahtarları DEĞERSİZ listeler. Gerçek `.env` dosyası
#        .gitignore ile dışlanmıştır ve repoya ASLA girmez.
# §8.18: NEXT_PUBLIC_ önekli hiçbir değişkende sır bulunmaz — bu dosyadaki
#        NEXT_PUBLIC_* anahtarları tarayıcıya gömülür, gizli değerdir sanılmasın.
#
# Kurulum: `cp .env.example .env` → değerleri doldur.
# =============================================================================

# --- Uygulama ---------------------------------------------------------------
# Yerelde http://localhost:3000 · üretimde https://sahinsamet.com
NEXT_PUBLIC_SITE_URL=
# örn. development | production   (next dev/build genelde kendisi ayarlar)
NODE_ENV=

# --- Veritabanı -------------------------------------------------------------
# Yerel geliştirme (docker-compose.dev.yml ile birebir uyumlu):
#   postgresql://sahinsamet:sahinsamet_dev_only@127.0.0.1:5434/sahinsamet?schema=public
#
# Host portu neden 5434: 5432 çoğu makinede sistem PostgreSQL'inin, 5433 başka
# bir yerel projenin olabilir. Çakışma SESSİZDİR — container "healthy" görünür
# ama bağlantılar başka sunucuya gider ve `role "sahinsamet" does not exist` gibi
# yanıltıcı bir hata alırsınız. Container içi port 5432 olarak kalır.
#
# Üretimde Postgres aynı compose ağında olduğu için host `db`, port 5432
# (deploy/sunucu/docker-compose.yml bu değeri kendisi kurar).
DATABASE_URL=

# --- Auth (§8.1–8.3) --------------------------------------------------------
# örn. `openssl rand -base64 32` çıktısı
AUTH_SECRET=
# NEXT_PUBLIC_SITE_URL ile aynı, örn. https://sahinsamet.com
AUTH_URL=
# Tek kullanıcının (site sahibinin) e-posta adresi — seed bu hesabı açar.
ADMIN_EMAIL=
# Panelde görünen ad (boşsa "Samet Şahin").
ADMIN_NAME=
# argon2id hash — düz şifre DEĞİL (§8.2: memory >= 19MB, iterations >= 2).
# Yalnızca ilk kurulum kolaylığı için ADMIN_PASSWORD (düz şifre) de kabul
# edilir; seed onu hash'ler ve hiçbir yere yazmaz. İkisinden biri yeterli.
ADMIN_PASSWORD_HASH=
ADMIN_PASSWORD=
# TOTP uygulamasında görünecek yayıncı adı, örn. SŞ Panel
TOTP_ISSUER=
# User.totpSecret'ı uygulama seviyesinde şifreler (ADR-013).
# örn. `openssl rand -base64 32` çıktısı
#
# DİKKAT: Bu anahtar KAYBOLURSA hiçbir TOTP secret'ı çözülemez ve 2FA kurulumu
# sıfırdan yapılmak zorunda kalır. BACKUP_ENCRYPTION_KEY ile aynı ciddiyette
# saklanmalıdır.
TOTP_ENCRYPTION_KEY=

# --- Depolama: Cloudflare R2 (§8.11 — private bucket) ------------------------
# Profil fotoğrafı yüklemek için gerekli. Boşsa yükleme kapalıdır, sayfa baş
# harfleri gösterir.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

# --- Sağlık · yapay zekâ (tartı görseli okuma, yorum) -----------------------
# Boşsa özellik kapalı; form elle doldurulur. Anahtarı yalnızca sunucu .env'ine yaz.
ANTHROPIC_API_KEY=

# --- Bildirimler (web push) — boşsa kapalı. Üret: node scripts/vapid-uret.mjs
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# örn. mailto:bildirim@sahinsamet.com
VAPID_SUBJECT=

# --- Yedekleme (§8.21–8.23) -------------------------------------------------
# pg_dump çıktısının şifrelenmesinde kullanılır — kaybolursa yedekler açılamaz
BACKUP_ENCRYPTION_KEY=
BACKUP_R2_BUCKET=

# --- Ziyaretçi analitiği — İSTEĞE BAĞLI, Umami (kendi sunucunda, çerezsiz) --
# İkisi birden doluysa public sayfaya betik eklenir, CSP connect-src bu kökene açılır.
UMAMI_URL=
UMAMI_SITE_ID=

# --- Yalnızca yerel e2e ------------------------------------------------------
# Playwright'ın Face ID testi `localhost`ta koşar; üretim derlemesi bu kökeni
# WebAuthn RP olarak tanısın. ÜRETİMDE TANIMLAMAYIN.
# örn. http://localhost:3100
PASSKEY_TEST_KOKENI=
